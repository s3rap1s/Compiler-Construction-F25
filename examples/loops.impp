routine sum(arr : array[arr.length] integer) : integer is
    var sum is 0
    for elem in arr loop
        sum := sum + elem
    end
    return sum
end    


routine main() is
    arr[1] := 10
    arr[2] := 20
    arr[3] := 30
    for i in 1..3 loop
        i := 2
        print arr[i]
    end
    var s is sum(arr)
    for i in 1..3 reverse loop
        print arr[i]
    end

    for i in 5..1 loop
        print i
    end
end
