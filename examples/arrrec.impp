type Point is record
    var x: integer
    var y: integer
end

type Points is array[1+1] Point

type Container is record
    var points: Points
end

routine sideff(ps:Points) is
    ps[1].x := 10
    print "Size:", ps.size
end

var c: Container

routine main() is
    c.points[1].x := 20
    print c.points[1].x
    sideff(c.points)
    print c.points[1].x

    c.points[1].y := 2
    c.points[2].x := 3
    c.points[2].y := 4

    for p in c.points reverse loop
        print "Point:", p.x, p.y
    end
end
