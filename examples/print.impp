routine hw() is
    print "Hello, World!", 123
end

routine sqr(x : integer) => x * x

routine changeArr(arr : array[1] integer) is
    arr[1] := 20
end

routine main() : integer is
    hw
    print sqr(4)
    var arr : array[1] integer
    arr[1] := 10
    print arr.size
    changeArr(arr)
    print arr[1]
    return 0
end
